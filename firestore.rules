rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function meuUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function ativo() {
      return logado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && meuUsuario().ativo == true
        && meuUsuario().papeis.size() > 0;
    }

    function temPapel(papel) {
      return ativo() && (papel in meuUsuario().papeis);
    }

    // Master cria e remove acessos e passa em tudo (atalho "Master vê tudo"
    // do OnTrac). Editor mexe no conteúdo do site; Gestor e Professor são do
    // app de gestão (docs/gestao.md, §1 e §5) — Gestor administra a
    // escolinha, Professor só faz chamada e vê alunos.
    function isMaster() {
      return temPapel('Master');
    }

    function isEditor() {
      return isMaster() || temPapel('Editor');
    }

    function isGestor() {
      return isMaster() || temPapel('Gestor');
    }

    function isProfessor() {
      return isGestor() || temPapel('Professor');
    }

    function colecaoDoSite(nome) {
      return nome in ['site_turmas', 'site_destaques', 'site_titulos', 'site_historia', 'site_parceiros'];
    }

    // ---------------- conteúdo do site ----------------
    // O site público lê SEM login, mas só o que está marcado como visível: a
    // consulta do site vem com where('visivel', '==', true), que é o que
    // satisfaz a regra de lista. Quem edita enxerga tudo, inclusive o oculto.
    match /{colecao}/{id} {
      allow read: if colecaoDoSite(colecao) && (resource.data.visivel == true || isEditor());
      allow create, update: if colecaoDoSite(colecao) && isEditor()
        && request.resource.data.visivel is bool;
      allow delete: if colecaoDoSite(colecao) && isEditor();
    }

    // Textos soltos do site (site_config/textos): um documento só.
    match /site_config/{documento} {
      allow read: if true;
      allow write: if isEditor();
    }

    // ---------------- contas ----------------
    // Cada pessoa lê o próprio registro (é o que diz ao painel quais papéis ela
    // tem); o Master lê e mexe em todos. Ninguém apaga: desligar `ativo` é o
    // caminho, para preservar quem editava o quê.
    // O Gestor também lê a lista: é dela que escolhe o professor da turma.
    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || isGestor());
      allow create: if isMaster()
        && request.resource.data.keys().hasAll(['nome', 'email', 'ativo', 'papeis'])
        && request.resource.data.papeis is list;
      // Trava contra tirar o próprio acesso de Master por engano — sem isso a
      // escolinha ficaria sem ninguém que consiga criar conta.
      allow update: if isMaster()
        && request.resource.data.papeis is list
        && !(request.auth.uid == uid
             && (request.resource.data.ativo != true || !('Master' in request.resource.data.papeis)));
      allow delete: if false;
    }

    // ---------------- gestão da escolinha (docs/gestao.md, §5) ----------------
    // Nada disso é público. Professor lê para fazer a chamada; Gestor grava.
    match /turmas/{id} {
      allow read: if isProfessor();
      allow create, update: if isGestor()
        && request.resource.data.nome is string
        && request.resource.data.ativa is bool
        && request.resource.data.horarios is list;
      allow delete: if false;
    }

    // Chamada: um documento por treino, gravado por quem chama (Professor
    // também). Só cresce por merge; apagar não existe.
    match /chamadas/{id} {
      allow read: if isProfessor();
      allow create, update: if isProfessor()
        && request.resource.data.turmaId is string
        && request.resource.data.data is string
        && id == request.resource.data.turmaId + '_' + request.resource.data.data;
      allow delete: if false;
    }

    match /alunos/{id} {
      allow read: if isProfessor();
      allow create, update: if isGestor()
        && request.resource.data.nome is string
        && request.resource.data.situacao in ['pre_matricula', 'ativo', 'trancado', 'desligado']
        && request.resource.data.responsaveis is list;
      // Desligar é o caminho: a ficha e o histórico ficam para sempre.
      allow delete: if false;

      // Linha do tempo do aluno: só cresce. Corrigir é registrar outra linha.
      match /historico/{registro} {
        allow read: if isProfessor();
        allow create: if isGestor() && request.resource.data.tipo is string && request.resource.data.data is string;
        allow update, delete: if false;
      }
    }

    // Pré-matrícula: o formulário do site grava SEM login, só com os campos
    // dele e já como 'nova'. Ler e mexer é do Gestor. Nada se apaga.
    match /pre_matriculas/{id} {
      allow read: if isGestor();
      allow create: if request.resource.data.keys().hasOnly(['crianca', 'idade', 'turmaSugerida', 'responsavel', 'telefone', 'observacao', 'situacao', 'origem', 'criadoEm'])
        && request.resource.data.crianca is string && request.resource.data.crianca.size() > 0 && request.resource.data.crianca.size() <= 80
        && request.resource.data.idade is number
        && request.resource.data.responsavel is string && request.resource.data.responsavel.size() <= 80
        && request.resource.data.telefone is string && request.resource.data.telefone.size() <= 20
        && request.resource.data.observacao is string && request.resource.data.observacao.size() <= 500
        && request.resource.data.turmaSugerida is string && request.resource.data.turmaSugerida.size() <= 80
        && request.resource.data.situacao == 'nova'
        && request.resource.data.origem == 'site';
      allow update: if isGestor()
        && request.resource.data.situacao in ['nova', 'em_contato', 'matriculada', 'recusada'];
      allow delete: if false;
    }

    // Agenda: quem entra no app lê; o site lê só o marcado para ele
    // (a consulta vem com where('visivelNoSite', '==', true)).
    match /eventos/{id} {
      allow read: if isProfessor() || resource.data.visivelNoSite == true;
      allow create, update: if isGestor()
        && request.resource.data.titulo is string
        && request.resource.data.data is string
        && request.resource.data.visivelNoSite is bool;
      allow delete: if isGestor();
    }

    // Avisos enviados: histórico do que foi mandado por WhatsApp.
    match /avisos/{id} {
      allow read: if isProfessor();
      allow create: if isGestor();
      allow update, delete: if false;
    }

    // Mensalidades: só o Gestor. Cancelar é a saída; apagar não existe.
    match /cobrancas/{id} {
      allow read: if isGestor();
      allow create, update: if isGestor()
        && request.resource.data.alunoId is string
        && request.resource.data.competencia is string
        && request.resource.data.situacao in ['aberta', 'paga', 'isenta', 'cancelada']
        && id == request.resource.data.alunoId + '_' + request.resource.data.competencia;
      allow delete: if false;
    }

    // Configurações da escolinha: um documento, todo mundo do app lê (chave
    // Pix, locais), o Gestor escreve.
    match /configuracoes/{documento} {
      allow read: if isProfessor();
      allow write: if isGestor();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
