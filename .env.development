# `npm run dev` fala com os emuladores (npm run emulators), no projeto demo.
# Projeto "demo-*" e o nome que o Firebase reserva para emulador puro: nada
# aqui toca a nuvem.
VITE_FIREBASE_API_KEY=demo
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-patotina
VITE_FIREBASE_STORAGE_BUCKET=demo-patotina.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=demo
VITE_USAR_EMULADORES=true
