# Config web do projeto Firebase REAL (Console > Configuracoes do projeto >
# Seus apps > SDK setup). Nao e segredo: a protecao vem das regras do
# Firestore/Storage. Copie para .env.production antes de `npm run build`.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=patotina.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=patotina
VITE_FIREBASE_STORAGE_BUCKET=patotina.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_USAR_EMULADORES=false
